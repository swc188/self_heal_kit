# Python caches / build artefacts
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp

# Local scratch dirs (self_test uses system temp, but keep repo clean)
work/
tmp/

# Quarantined unexpected files (strict-mode isolation, reversible)
.quarantine/

# Isolated virtual environment (created in-dir, not committed)
.venv/
venv/

# Baseline snapshots (make_baseline --snapshot) — working artifacts of the
# kit itself; the authoritative baseline.json IS committed.
baselines/
